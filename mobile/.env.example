# Bu dosyayı ".env" adıyla kopyala ve değerleri doldur (".env" git'e girmez).
# Değerler: Supabase > Project Settings > API Keys (ya da admin/.env.local).
# Yalnızca publishable key; secret / service role key buraya asla yazılmaz.
# Çalıştırma: flutter run --dart-define-from-file=.env
SUPABASE_URL=https://<proje-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
